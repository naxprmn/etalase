# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing & test artifacts
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/.vitest/
/vitest-results/

# next.js & production builds
/.next/
/out/
/build
/dist

# runtime uploads & user generated media
/public/uploads/*
!/public/uploads/.gitkeep

# environment & secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# debug & package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# vercel
.vercel

# typescript & build caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache

# agent, telemetry & local tooling artifacts
.agents/
.codex/
.impeccable/
.github/skills/
.github/hooks/
graphify-out/
.playwright-mcp/

# temporary images, audit screenshots & visual diffs
*.png
/*.jpg
/*.jpeg
/*.webp

# preserve legitimate static assets
!/public/assets/**
!/assets/**

# IDEs, editors & OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
.claude/
*.swp
*.swo
*.swn
*.bak
*~
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# python & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.venv/
venv/
ENV/
env/
